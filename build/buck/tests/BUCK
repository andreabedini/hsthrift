# Programs using the C++ dependencies, to check that their targets carry
# what a program needs to compile and link against them.

cxx_binary(
    name = "folly_smoke",
    srcs = ["folly_smoke.cpp"],
    compiler_flags = ["-std=c++20"],
    deps = ["//build/buck/deps/folly:folly"],
)

sh_test(
    name = "folly_smoke-test",
    test = ":folly_smoke",
)
