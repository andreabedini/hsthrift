[cells]
  root = .
  prelude = prelude
  toolchains = build/buck/toolchains
  timbuktu = build/buck/timbuktu
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled
  timbuktu = git

# The Haskell rules: https://github.com/andreabedini/timbuktu
[external_cell_timbuktu]
  git_origin = https://github.com/andreabedini/timbuktu.git
  commit_hash = 2e862314766c473a4dd1e03083cc1431f3d21fc7

[build]
  execution_platforms = prelude//platforms:default

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:toolchains//...->prelude//platforms:default target:timbuktu//...->prelude//platforms:default

[project]
  ignore = .git, .jj, dist-newstyle
